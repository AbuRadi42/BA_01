# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Data — raw and processed (large binary files)
morph_efficiency_project/data/raw/**/*.txt
morph_efficiency_project/data/raw/**/*.json
morph_efficiency_project/data/processed/**/*.npy
morph_efficiency_project/data/processed/**/*.bin

# Model checkpoints (can be hundreds of GB)
morph_efficiency_project/models/**/*.pt
morph_efficiency_project/models/**/*.pth
morph_efficiency_project/models/**/*.bin
morph_efficiency_project/models/**/*.safetensors

# Tokenizer artifacts (generated by scripts)
morph_efficiency_project/tokenizers/**/*.model
morph_efficiency_project/tokenizers/**/*.vocab
morph_efficiency_project/tokenizers/**/*.json
morph_efficiency_project/tokenizers/**/*.bin
# Keep feature_bundles.json and vocab.json if you want to commit them
# (comment out the *.json line above and uncomment below)
# !morph_efficiency_project/tokenizers/**/feature_bundles.json
# !morph_efficiency_project/tokenizers/**/vocab.json

# Logs — evaluation and training outputs (generated at runtime)
morph_efficiency_project/logs/evaluation/*.json
morph_efficiency_project/logs/training/*.json
morph_efficiency_project/logs/training/*.jsonl
morph_efficiency_project/logs/summary/conclusion.md
morph_efficiency_project/logs/logs
# (Audit reports, bundle distribution plots, and bundle_space.json in
# logs/summary/ are kept; they are paper-grade artefacts, not per-run output.)

# Manuscript build outputs (Tectonic temp dirs)
manuscript/tex/_build*/

# Mini-experiment derived artefacts (rebuildable via tokenize_for_training.py)
mini_experiment/data/*.npy
mini_experiment/data/*.txt
mini_experiment/data/download_log.jsonl
mini_experiment/tokenizers/tokenizers/
morph_efficiency_project/tokenizers/tokenizers

# Local backups
backup/

# Morph chunk train directories
morph_efficiency_project/data/processed/en/morph_chunks_train/

# Keep .gitkeep files in all of the above
!**/.gitkeep

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/

# Misc
*.log
*.tmp
*.swp

# LaTeX build artefacts (Tectonic --outdir targets)
_build*/
_expose_build*/
**/_build*/
**/_expose_build*/

# Mini-experiment large artefacts (corpora, model checkpoints, tokenizer dumps)
mini_experiment/data/
mini_experiment/results_ladder/
mini_experiment/tokenizers/

# Exported HTML reports (generated, not source)
morph_efficiency_project/Morphological Efficiency in Multilingual Language Models.html
morph_efficiency_project/Morphological Efficiency in Multilingual Language Models_files/

# Personal academic artefacts (not project IP)
STS_*Reflection.pdf
BM_*Reflection.pdf
SE_*Reflection.pdf
Capstone\ Exposé.pdf

# Sidequest exposé (canonical copy lives in ~/Downloads)
thesis_expose_pn1_autoethnography.pdf
thesis_expose_pn1_autoethnography.tex
thesis_expose_pn1_autoethnography.md

# Claude Code local data

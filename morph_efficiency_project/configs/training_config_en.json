{
  "language": "en",
  "data": {
    "train": "data/raw/en/train.txt",
    "val":   "data/raw/en/val.txt",
    "test":  "data/raw/en/test.txt",
    "sources": ["Wikipedia EN", "OPUS (TED/News)", "CC-100 EN"],
    "target_train_tokens": 8000000000,
    "target_val_tokens":    200000000,
    "target_test_tokens":   200000000
  },
  "tokenizer": {
    "baseline": {
      "type": "sentencepiece_bpe",
      "vocab_size": 32000,
      "character_coverage": 0.9995,
      "save_path": "tokenizers/en_base/"
    },
    "morph": {
      "type": "morpheme_inventory",
      "vocab_size": "determined_after_preprocessing",
      "expected_range": "15000-25000",
      "save_path": "tokenizers/en_morph/",
      "feature_bundles_path": "tokenizers/en_morph/feature_bundles.json"
    }
  },
  "training": {
    "batch_size": 32,
    "sequence_length": 1024,
    "optimizer": "AdamW",
    "learning_rate": 3e-4,
    "lr_schedule": "linear_warmup_cosine_decay",
    "warmup_steps": 2000,
    "weight_decay": 0.01,
    "gradient_clipping": 1.0,
    "total_tokens": 8400000000,
    "checkpoint_interval_steps": 1000
  },
  "grammar_engine": {
    "analyzer": "spacy",
    "model": "en_core_web_trf",
    "fallback": "stanza",
    "configs": {
      "irregulars":    "configs/en_irregulars.json",
      "derivations":   "configs/en_derivations.json",
      "compounds":     "configs/en_compounds.json",
      "phrasal_verbs": "configs/en_phrasal_verbs.json"
    }
  },
  "logs": {
    "training":   "logs/training/en_{regime}_training.json",
    "eval_lm":    "logs/evaluation/en_{regime}_lm.json",
    "eval_morph": "logs/evaluation/en_{regime}_morph.json",
    "eval_compute":"logs/evaluation/en_{regime}_compute.json",
    "token_stats": "logs/evaluation/en_{regime}_token_stats.json",
    "foreign_rate":"logs/evaluation/en_morph_foreign_rate.json"
  }
}

[
  {
    "affix": "-ung",
    "surface_variants": ["-ung"],
    "type": "SUFFIX",
    "direction": "V->N",
    "derives": "ACTION_NOUN",
    "notes": "Nominalizes verbs into action/process nouns. Always feminine.",
    "examples": ["Bildung <- bilden", "Ordnung <- ordnen", "Bewegung <- bewegen"]
  },
  {
    "affix": "-heit",
    "surface_variants": ["-heit"],
    "type": "SUFFIX",
    "direction": "ADJ->N",
    "derives": "QUALITY_NOUN",
    "notes": "Forms abstract quality nouns from adjectives. Always feminine.",
    "examples": ["Freiheit <- frei", "Schönheit <- schön", "Wahrheit <- wahr"]
  },
  {
    "affix": "-keit",
    "surface_variants": ["-keit"],
    "type": "SUFFIX",
    "direction": "ADJ->N",
    "derives": "QUALITY_NOUN",
    "notes": "Variant of -heit after -ig, -lich, -bar, -sam. Always feminine.",
    "examples": ["Möglichkeit <- möglich", "Fähigkeit <- fähig", "Dankbarkeit <- dankbar"]
  },
  {
    "affix": "-igkeit",
    "surface_variants": ["-igkeit"],
    "type": "SUFFIX",
    "direction": "ADJ->N",
    "derives": "QUALITY_NOUN",
    "notes": "Extended quality noun suffix. Always feminine.",
    "examples": ["Geschwindigkeit <- geschwind", "Ewigkeit <- ewig"]
  },
  {
    "affix": "-nis",
    "surface_variants": ["-nis", "-niss"],
    "type": "SUFFIX",
    "direction": "V->N",
    "derives": "RESULT_NOUN",
    "notes": "Forms result nouns. Usually neuter, sometimes feminine.",
    "examples": ["Ergebnis <- ergeben", "Kenntnis <- kennen", "Erlebnis <- erleben"]
  },
  {
    "affix": "-schaft",
    "surface_variants": ["-schaft"],
    "type": "SUFFIX",
    "direction": "N->N",
    "derives": "COLLECTIVE",
    "notes": "Forms collective/abstract nouns. Always feminine.",
    "examples": ["Freundschaft <- Freund", "Gesellschaft <- Geselle", "Wissenschaft <- Wissen"]
  },
  {
    "affix": "-tum",
    "surface_variants": ["-tum"],
    "type": "SUFFIX",
    "direction": "N->N",
    "derives": "STATE_DOMAIN",
    "notes": "Forms state/domain nouns. Usually neuter.",
    "examples": ["Eigentum <- eigen", "Christentum <- Christ", "Reichtum <- reich"]
  },
  {
    "affix": "-lich",
    "surface_variants": ["-lich"],
    "type": "SUFFIX",
    "direction": "N->ADJ",
    "derives": "RESEMBLANCE",
    "notes": "Forms adjectives expressing resemblance or periodic quality.",
    "examples": ["freundlich <- Freund", "täglich <- Tag", "menschlich <- Mensch"]
  },
  {
    "affix": "-isch",
    "surface_variants": ["-isch"],
    "type": "SUFFIX",
    "direction": "N->ADJ",
    "derives": "RELATING_TO",
    "notes": "Forms adjectives relating to a noun, often with pejorative connotation.",
    "examples": ["kindisch <- Kind", "europäisch <- Europa", "tierisch <- Tier"]
  },
  {
    "affix": "-ig",
    "surface_variants": ["-ig"],
    "type": "SUFFIX",
    "direction": "N->ADJ",
    "derives": "HAVING_QUALITY",
    "notes": "Forms adjectives expressing possession of a quality.",
    "examples": ["sonnig <- Sonne", "ruhig <- Ruhe", "lustig <- Lust"]
  },
  {
    "affix": "-bar",
    "surface_variants": ["-bar"],
    "type": "SUFFIX",
    "direction": "V->ADJ",
    "derives": "ABILITY",
    "notes": "Forms adjectives expressing ability/possibility (like English -able).",
    "examples": ["machbar <- machen", "essbar <- essen", "trinkbar <- trinken"]
  },
  {
    "affix": "-sam",
    "surface_variants": ["-sam"],
    "type": "SUFFIX",
    "direction": "V->ADJ",
    "derives": "TENDENCY",
    "notes": "Forms adjectives expressing tendency.",
    "examples": ["langsam <- lang", "wirksam <- wirken", "gemeinsam <- gemein"]
  },
  {
    "affix": "-haft",
    "surface_variants": ["-haft"],
    "type": "SUFFIX",
    "direction": "N->ADJ",
    "derives": "HAVING_QUALITY",
    "notes": "Forms adjectives expressing having a quality.",
    "examples": ["fehlerhaft <- Fehler", "schmerzhaft <- Schmerz", "lebhaft <- Leben"]
  },
  {
    "affix": "-los",
    "surface_variants": ["-los"],
    "type": "SUFFIX",
    "direction": "N->ADJ",
    "derives": "WITHOUT",
    "notes": "Forms adjectives meaning 'without' (like English -less).",
    "examples": ["arbeitslos <- Arbeit", "hoffnungslos <- Hoffnung", "endlos <- Ende"]
  },
  {
    "affix": "-voll",
    "surface_variants": ["-voll"],
    "type": "SUFFIX",
    "direction": "N->ADJ",
    "derives": "FULL_OF",
    "notes": "Forms adjectives meaning 'full of'.",
    "examples": ["wertvoll <- Wert", "liebevoll <- Liebe", "sinnvoll <- Sinn"]
  },
  {
    "affix": "-reich",
    "surface_variants": ["-reich"],
    "type": "SUFFIX",
    "direction": "N->ADJ",
    "derives": "RICH_IN",
    "notes": "Forms adjectives meaning 'rich in'.",
    "examples": ["erfolgreich <- Erfolg", "zahlreich <- Zahl", "kinderreich <- Kind"]
  },
  {
    "affix": "-arm",
    "surface_variants": ["-arm"],
    "type": "SUFFIX",
    "direction": "N->ADJ",
    "derives": "LOW_IN",
    "notes": "Forms adjectives meaning 'low in/poor in'.",
    "examples": ["fettarm <- Fett", "wasserarm <- Wasser"]
  },
  {
    "affix": "-er",
    "surface_variants": ["-er"],
    "type": "SUFFIX",
    "direction": "V->N",
    "derives": "AGENT",
    "notes": "Forms agent nouns from verbs. Always masculine.",
    "examples": ["Lehrer <- lehren", "Spieler <- spielen", "Arbeiter <- arbeiten"]
  },
  {
    "affix": "-in",
    "surface_variants": ["-in"],
    "type": "SUFFIX",
    "direction": "N->N",
    "derives": "FEMININE_AGENT",
    "notes": "Forms feminine agent nouns from masculine. Always feminine.",
    "examples": ["Lehrerin <- Lehrer", "Ärztin <- Arzt", "Freundin <- Freund"]
  },
  {
    "affix": "-erin",
    "surface_variants": ["-erin"],
    "type": "SUFFIX",
    "direction": "V->N",
    "derives": "FEMININE_AGENT",
    "notes": "Forms feminine agent nouns directly from verbs.",
    "examples": ["Lehrerin <- lehren", "Spielerin <- spielen"]
  },
  {
    "affix": "-ler",
    "surface_variants": ["-ler"],
    "type": "SUFFIX",
    "direction": "N->N",
    "derives": "AGENT",
    "notes": "Forms agent nouns, often with slightly informal tone.",
    "examples": ["Künstler <- Kunst", "Sportler <- Sport", "Wissenschaftler <- Wissenschaft"]
  },
  {
    "affix": "-ner",
    "surface_variants": ["-ner"],
    "type": "SUFFIX",
    "direction": "N->N",
    "derives": "AGENT",
    "notes": "Forms agent nouns.",
    "examples": ["Redner <- Rede", "Rentner <- Rente", "Gärtner <- Garten"]
  },
  {
    "affix": "-chen",
    "surface_variants": ["-chen"],
    "type": "SUFFIX",
    "direction": "N->N",
    "derives": "DIMINUTIVE",
    "notes": "Diminutive suffix. Always neuter. Often triggers Umlaut.",
    "examples": ["Häuschen <- Haus", "Mädchen <- Magd", "Brötchen <- Brot"]
  },
  {
    "affix": "-lein",
    "surface_variants": ["-lein"],
    "type": "SUFFIX",
    "direction": "N->N",
    "derives": "DIMINUTIVE",
    "notes": "Diminutive suffix (more literary/dialectal). Always neuter.",
    "examples": ["Büchlein <- Buch", "Kindlein <- Kind", "Fräulein <- Frau"]
  },
  {
    "affix": "-ling",
    "surface_variants": ["-ling"],
    "type": "SUFFIX",
    "direction": "V->N",
    "derives": "PERSON",
    "notes": "Forms person nouns, often with passive/diminutive connotation. Always masculine.",
    "examples": ["Lehrling <- lehren", "Flüchtling <- flüchten", "Fremdling <- fremd"]
  },
  {
    "affix": "-sel",
    "surface_variants": ["-sel"],
    "type": "SUFFIX",
    "direction": "V->N",
    "derives": "RESULT",
    "notes": "Forms result nouns from verbs. Usually neuter.",
    "examples": ["Rätsel <- raten", "Überbleibsel <- überbleiben"]
  },
  {
    "affix": "-e",
    "surface_variants": ["-e"],
    "type": "SUFFIX",
    "direction": "ADJ->N",
    "derives": "QUALITY_ABSTRACT",
    "notes": "Forms abstract quality nouns from adjectives. Often with Umlaut. Always feminine.",
    "examples": ["Stärke <- stark", "Größe <- groß", "Länge <- lang"]
  },
  {
    "affix": "-ieren",
    "surface_variants": ["-ieren"],
    "type": "SUFFIX",
    "direction": "N->V",
    "derives": "VERBALIZE",
    "notes": "Forms verbs from (often foreign) nouns. No ge- in Partizip II.",
    "examples": ["studieren <- Studium", "telefonieren <- Telefon", "operieren <- Operation"]
  },
  {
    "affix": "-isieren",
    "surface_variants": ["-isieren"],
    "type": "SUFFIX",
    "direction": "ADJ->V",
    "derives": "VERBALIZE",
    "notes": "Forms verbs meaning 'to make X'. No ge- in Partizip II.",
    "examples": ["modernisieren <- modern", "privatisieren <- privat"]
  },
  {
    "affix": "un-",
    "surface_variants": ["un-"],
    "type": "PREFIX",
    "direction": "ADJ->ADJ",
    "derives": "NEGATION",
    "notes": "Negation prefix for adjectives and nouns.",
    "examples": ["unmöglich <- möglich", "Unglück <- Glück", "unfrei <- frei"]
  },
  {
    "affix": "ur-",
    "surface_variants": ["ur-"],
    "type": "PREFIX",
    "direction": "N->N",
    "derives": "ORIGINAL",
    "notes": "Prefix meaning 'original, primordial'.",
    "examples": ["uralt <- alt", "Urwald <- Wald", "Ursache <- Sache"]
  },
  {
    "affix": "miss-",
    "surface_variants": ["miss-"],
    "type": "PREFIX",
    "direction": "V->V",
    "derives": "WRONG",
    "notes": "Prefix meaning 'wrong, bad'.",
    "examples": ["Misserfolg <- Erfolg", "missbrauchen <- brauchen", "Missverständnis <- Verständnis"]
  },
  {
    "affix": "Ge-",
    "surface_variants": ["ge-"],
    "type": "PREFIX",
    "direction": "V->N",
    "derives": "COLLECTIVE",
    "notes": "Collective/iterative prefix forming neuter nouns from verbs.",
    "examples": ["Gerede <- reden", "Gebirge <- Berg", "Getränk <- trinken"]
  },
  {
    "affix": "Haupt-",
    "surface_variants": ["haupt-"],
    "type": "PREFIX",
    "direction": "N->N",
    "derives": "MAIN",
    "notes": "Prefix meaning 'main, principal'.",
    "examples": ["Hauptstadt <- Stadt", "Hauptstraße <- Straße"]
  },
  {
    "affix": "Grund-",
    "surface_variants": ["grund-"],
    "type": "PREFIX",
    "direction": "N->N",
    "derives": "BASIC",
    "notes": "Prefix meaning 'basic, fundamental'.",
    "examples": ["Grundschule <- Schule", "Grundlage <- Lage"]
  },
  {
    "affix": "Neben-",
    "surface_variants": ["neben-"],
    "type": "PREFIX",
    "direction": "N->N",
    "derives": "SECONDARY",
    "notes": "Prefix meaning 'secondary, side'.",
    "examples": ["Nebenstraße <- Straße", "Nebenwirkung <- Wirkung"]
  },
  {
    "affix": "Vor-",
    "surface_variants": ["vor-"],
    "type": "PREFIX",
    "direction": "N->N",
    "derives": "PRE",
    "notes": "Prefix meaning 'pre-, former, front'.",
    "examples": ["Vorstadt <- Stadt", "Vorteil <- Teil", "Vorname <- Name"]
  },
  {
    "affix": "Nach-",
    "surface_variants": ["nach-"],
    "type": "PREFIX",
    "direction": "N->N",
    "derives": "POST",
    "notes": "Prefix meaning 'post-, successor, after'.",
    "examples": ["Nachfolger <- Folger", "Nachricht <- Richt"]
  },
  {
    "affix": "Über-",
    "surface_variants": ["über-", "ueber-"],
    "type": "PREFIX",
    "direction": "ADJ->ADJ",
    "derives": "EXCESSIVE",
    "notes": "Prefix meaning 'over, excessive'.",
    "examples": ["übergroß <- groß", "übermäßig <- mäßig"]
  },
  {
    "affix": "Unter-",
    "surface_variants": ["unter-"],
    "type": "PREFIX",
    "direction": "N->N",
    "derives": "SUB",
    "notes": "Prefix meaning 'sub-, under'.",
    "examples": ["Untergruppe <- Gruppe", "Unterricht <- Richt"]
  },
  {
    "affix": "Rück-",
    "surface_variants": ["rück-", "rueck-"],
    "type": "PREFIX",
    "direction": "N->N",
    "derives": "BACK",
    "notes": "Prefix meaning 'back, return'.",
    "examples": ["Rückfahrt <- Fahrt", "Rückkehr <- Kehr"]
  },
  {
    "affix": "Mit-",
    "surface_variants": ["mit-"],
    "type": "PREFIX",
    "direction": "N->N",
    "derives": "CO",
    "notes": "Prefix meaning 'co-, with'.",
    "examples": ["Mitarbeiter <- Arbeiter", "Mitglied <- Glied"]
  },
  {
    "affix": "Anti-",
    "surface_variants": ["anti-"],
    "type": "PREFIX",
    "direction": "N->N",
    "derives": "AGAINST",
    "notes": "Prefix meaning 'against, anti-'.",
    "examples": ["Antiheld <- Held", "Antikörper <- Körper"]
  },
  {
    "affix": "Nicht-",
    "surface_variants": ["nicht-"],
    "type": "PREFIX",
    "direction": "N->N",
    "derives": "NON",
    "notes": "Prefix meaning 'non-'.",
    "examples": ["Nichtraucher <- Raucher"]
  }
]

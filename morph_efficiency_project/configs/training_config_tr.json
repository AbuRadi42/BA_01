{
  "language": "tr",
  "data": {
    "train": "data/raw/tr/train.txt",
    "val":   "data/raw/tr/val.txt",
    "test":  "data/raw/tr/test.txt",
    "sources": ["Wikipedia TR", "OPUS TR", "CC-100 TR"],
    "target_train_tokens": 2500000000,
    "target_val_tokens":    62500000,
    "target_test_tokens":   62500000
  },
  "tokenizer": {
    "baseline": {
      "type": "sentencepiece_bpe",
      "vocab_size": 32000,
      "character_coverage": 0.9995,
      "save_path": "tokenizers/tr_base/"
    },
    "morph": {
      "type": "stem_suffix_inventory",
      "vocab_size": "determined_after_preprocessing",
      "expected_range": "25000-50000",
      "save_path": "tokenizers/tr_morph/",
      "feature_bundles_path": "tokenizers/tr_morph/feature_bundles.json"
    }
  },
  "training": {
    "batch_size": 32,
    "sequence_length": 1024,
    "optimizer": "AdamW",
    "learning_rate": 3e-4,
    "lr_schedule": "linear_warmup_cosine_decay",
    "warmup_steps": 2000,
    "weight_decay": 0.01,
    "gradient_clipping": 1.0,
    "total_tokens": 2500000000,
    "checkpoint_interval_steps": 1000
  },
  "grammar_engine": {
    "analyzer": "zeyrek",
    "install": "pip install zeyrek",
    "stem_lexicon": "queried at runtime via analyzer.lexicon",
    "vowel_harmony": "normalize_to_logical_form_before_matching",
    "configs": {
      "suffixes":    "configs/tr_suffixes.json",
      "derivations": "configs/tr_derivations.json"
    }
  },
  "logs": {
    "training":    "logs/training/tr_{regime}_training.json",
    "eval_lm":     "logs/evaluation/tr_{regime}_lm.json",
    "eval_morph":  "logs/evaluation/tr_{regime}_morph.json",
    "eval_compute":"logs/evaluation/tr_{regime}_compute.json",
    "token_stats": "logs/evaluation/tr_{regime}_token_stats.json",
    "foreign_rate":"logs/evaluation/tr_morph_foreign_rate.json"
  }
}

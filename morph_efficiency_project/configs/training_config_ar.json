{
  "language": "ar",
  "data": {
    "train": "data/raw/ar/train.txt",
    "val":   "data/raw/ar/val.txt",
    "test":  "data/raw/ar/test.txt",
    "sources": ["Wikipedia AR", "OPUS AR", "CC-100 AR", "OSIAN"],
    "target_train_tokens": 8000000000,
    "target_val_tokens":    200000000,
    "target_test_tokens":   200000000
  },
  "tokenizer": {
    "baseline": {
      "type": "sentencepiece_bpe",
      "vocab_size": 32000,
      "character_coverage": 0.9995,
      "save_path": "tokenizers/ar_base/"
    },
    "morph": {
      "type": "root_template_inventory",
      "vocab_size": "determined_after_preprocessing",
      "expected_range": "20000-40000",
      "save_path": "tokenizers/ar_morph/",
      "feature_bundles_path": "tokenizers/ar_morph/feature_bundles.json"
    }
  },
  "training": {
    "batch_size": 32,
    "sequence_length": 1024,
    "optimizer": "AdamW",
    "learning_rate": 3e-4,
    "lr_schedule": "linear_warmup_cosine_decay",
    "warmup_steps": 2000,
    "weight_decay": 0.01,
    "gradient_clipping": 1.0,
    "total_tokens": 8400000000,
    "checkpoint_interval_steps": 1000
  },
  "grammar_engine": {
    "analyzer": "camel_tools",
    "fallback": "farasa",
    "diacritization": "use_where_available",
    "configs": {
      "roots":      "configs/ar_roots.json",
      "templates":  "configs/ar_templates.json",
      "vocab_space":"configs/ar_vocab_space.json"
    }
  },
  "logs": {
    "training":    "logs/training/ar_{regime}_training.json",
    "eval_lm":     "logs/evaluation/ar_{regime}_lm.json",
    "eval_morph":  "logs/evaluation/ar_{regime}_morph.json",
    "eval_compute":"logs/evaluation/ar_{regime}_compute.json",
    "token_stats": "logs/evaluation/ar_{regime}_token_stats.json",
    "foreign_rate":"logs/evaluation/ar_morph_foreign_rate.json"
  }
}
